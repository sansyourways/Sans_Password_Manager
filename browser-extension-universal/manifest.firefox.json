{
  "manifest_version": 3,
  "name": "Sans Password Manager",
  "version": "3.12.1",
  "description": "Explicit, domain-bound autofill through the local SPM native host.",
  "permissions": ["activeTab", "nativeMessaging", "scripting"],
  "background": {"scripts": ["background.js"]},
  "action": {"default_popup": "popup.html", "default_title": "SPM Autofill"},
  "browser_specific_settings": {
    "gecko": {"id": "browser-extension@sansyourways.xyz", "strict_min_version": "109.0"}
  }
}
